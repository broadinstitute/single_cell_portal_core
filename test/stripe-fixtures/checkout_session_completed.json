{
  "_meta": {
    "template_version": 0
  },
  "fixtures": [
    {
      "name": "payment_intent",
      "path": "/v1/payment_intents",
      "method": "post",
      "params": {
        "amount": 1000,
        "currency": "usd",
        "receipt_email": "${.env:CUSTOMER_EMAIL}",
        "metadata": {
          "study_accession": "${.env:STUDY_ACCESSION}"
        }
      }
    },
    {
      "name": "checkout_session",
      "path": "/v1/checkout/sessions",
      "method": "post",
      "params": {
        "mode": "payment",
        "customer_email": "${.env:CUSTOMER_EMAIL}",
        "line_items": [
          {
            "price": "price_1UI94KJD0wFmtKNegzkTTRbZ",
            "quantity": 1
          }
        ],
        "metadata": {
          "study_accession": "${.env:STUDY_ACCESSION}"
        },
        "success_url": "https://www.example.com/single_cell/purchases/success"
      }
    },
    {
      "name": "checkout_session_payment_confirm",
      "path": "/v1/payment_intents/${payment_intent:id}/confirm",
      "method": "post",
      "params": {
        "payment_method": "pm_card_visa",
        "return_url": "https://www.example.com/single_cell/purchases/success",
        "payment_details": { 
          "order_reference": "${checkout_session:id}"
        }
      }
    }
  ]
}
