<% content_for(:html_title) { 'Purchases - Single Cell Portal' } %>

<h1>Purchase history</h1>

<div class="table-responsive">
  <div class="well">
    <table class="table table-striped" id="purchases">
      <thead>
        <tr>
          <th>Product</th>
          <th>Associated Study</th>
          <th>Price</th>
          <th>Payment Status</th>
          <th>Sale Date</th>
        </tr>
      </thead>
      <tbody>
        <% @purchases.each do |purchase| %>
          <tr>
            <td><%= purchase.name %></td>
            <td><%= link_to purchase.study_accession, legacy_study_path(identifier: purchase.study_accession ) %></td>
            <td><%= number_to_currency(purchase.amount) %></td>
            <td><span class="label label-<%= purchase.paid? ? 'success' : 'warning' %>"><%= purchase.payment_status %></span></td>
            <td><%= purchase.sale_date.to_fs(:db) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <script type="text/javascript" nonce="<%= content_security_policy_script_nonce %>">
    $('#purchases').dataTable({
      order: [[4, 'desc']],
    });
  </script>
</div>
<h2>Available products</h2>
<p class="help-block">
  Use the form below to select available products for your SCP studies.  You will be redirected to our payment platform to 
  complete any purchases, and then return here once you have completed the transaction.
</p>
  <% @products.each do |product| %>
    <%= form_for :product, url: create_stripe_checkout_path, html: { class: 'form-inline', id: "product-#{product.id}" }, data: { turbo: false } do |f| %>
      <%= f.hidden_field :product_id, value: product.id %>    
      <div class="form-group">
        <strong><%= product.name %>:&nbsp;</strong> 
        <span class="text-muted"><%= product.description %></span>
        <%= f.select :study_accession, options_from_collection_for_select(@private_studies, :accession, :accession), {}, class: 'form-control' %>
      </div>
      <div class="form-group">
        <%= f.submit 'Begin purchase', class: 'btn btn-success' %>
      </div>
    <% end %>
<% end %>